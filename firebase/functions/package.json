{
    "name": "appacadabra-functions",
    "version": "1.0.0",
    "description": "Firebase Functions for Appacadabra AI operations",
    "main": "lib/index.js",
    "scripts": {
        "prebuild": "node --require ../../scripts/sucrase-register.js ../../scripts/sync-capability-docs.ts",
        "build": "tsc",
        "build:watch": "tsc --watch",
        "serve": "npm run build && firebase emulators:start --only functions",
        "shell": "npm run build && firebase functions:shell",
        "start": "npm run shell",
        "deploy": "firebase deploy --only functions",
        "logs": "firebase functions:log",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage"
    },
    "engines": {
        "node": "22"
    },
    "dependencies": {
        "@google/genai": "^1.0.0",
        "@react-native-firebase/app": "^23.8.3",
        "@react-native-firebase/app-check": "^23.8.3",
        "@react-native-firebase/auth": "^23.8.3",
        "@react-native-firebase/firestore": "^23.8.3",
        "@react-native-firebase/functions": "^23.8.3",
        "firebase-admin": "^13.0.0",
        "firebase-functions": "^6.3.0",
        "jsdom": "^25.0.0"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/jsdom": "^21.0.0",
        "firebase-functions-test": "^3.4.0",
        "jest": "^30.2.0",
        "ts-jest": "^29.4.6",
        "typescript": "^5.7.0"
    },
    "private": true
}
