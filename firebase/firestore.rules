rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - each user can only access their own document
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['pushToken', 'locale']);
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pushToken', 'locale']);
      allow delete: if false;
    }
    // Spell Store — published spells are public; writes go through Cloud Functions
    match /store_spells/{spellId} {
      allow read: if resource.data.status == 'active';
      allow write: if false;
    }
    match /users/{uid}/learned_spells/{spellId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
