{
    "hosting": {
        "public": ".",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "rewrites": [
            { "source": "/store/*/*", "destination": "/store/spell.html" },
            { "source": "/store/*", "destination": "/store/spell.html" },
            { "source": "/store", "destination": "/store/index.html" }
        ]
    }
}