{
    "hosting": {
        "public": ".",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**",
            "store/index.html"
        ],
        "rewrites": [
            { "source": "/store", "function": "storeSSR", "region": "southamerica-east1" },
            { "source": "/store/**", "function": "storeSSR", "region": "southamerica-east1" },
            { "source": "/sitemap-spells.xml", "function": "storeSitemap", "region": "southamerica-east1" }
        ]
    }
}