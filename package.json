    "vision:check": "node .maestro/scripts/vision_check.js",
    "test:e2e:clean": "node .maestro/scripts/clean.js",
    "test:e2e:clean:all": "node .maestro/scripts/clean.js --all",
    "prepare": "husky"
  },
