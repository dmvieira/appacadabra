    "emulator:start": "node .maestro/scripts/start-emulator.js",
    "test:e2e": "node .maestro/scripts/setup-device.js && \"%USERPROFILE%\\.maestro\\maestro\\bin\\maestro.bat\" test .maestro/flows/",
