  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild && node scripts/setup-android.js",
    "prebuild:clean": "expo prebuild --clean && node scripts/setup-android.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "sync-capabilities": "node --require ./scripts/sucrase-register.js scripts/sync-capabilities.ts",
