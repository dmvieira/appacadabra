{
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-2256826632523784~6570613208",
    "ios_app_id": "ca-app-pub-2256826632523784~6570613208"
  },
  "expo": {
    "name": "Appacadabra",
    "slug": "appacadabra",
    "version": "2.0.9",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "appacadabra",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A1A"
    },
    "notification": {
      "icon": "./assets/notification_icon.png",
      "color": "#023c69"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.appacadabra.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": [],
        "com.apple.security.application-groups": [
          "group.ai.appacadabra.app"
        ]
      },
      "infoPlist": {
        "LSSupportsOpeningDocumentsInPlace": true,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "All Files",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.item"
            ]
          }
        ],
        "NSCameraUsageDescription": "O app precisa aceder à câmara para apps gerados que usam câmara.",
        "NSMicrophoneUsageDescription": "O app precisa aceder ao microfone para gravação de voz e reconhecimento de fala.",
        "NSPhotoLibraryUsageDescription": "O app precisa aceder às fotos para definir ícones dos apps.",
        "NSContactsUsageDescription": "O app precisa aceder aos contactos para apps gerados que usam contactos.",
        "NSCalendarsUsageDescription": "O app precisa aceder ao calendário para ver e criar eventos.",
        "NSLocationWhenInUseUsageDescription": "O app precisa aceder à localização para apps gerados que usam GPS.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "O app precisa aceder à localização para apps gerados que usam GPS.",
        "NSMotionUsageDescription": "O app precisa aceder ao sensor de movimento para apps gerados que usam sensores.",
        "NSHealthShareUsageDescription": "O app precisa aceder aos dados de saúde para apps gerados que monitorizam atividade.",
        "NSHealthUpdateUsageDescription": "O app pode atualizar dados de saúde para apps gerados.",
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ],
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "appacadabra"
            ],
            "CFBundleURLName": "ai.appacadabra.app"
          }
        ]
      }
    },
    "web": {
      "package": "ai.appacadabra.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a2e"
      }
    },
    "android": {
      "package": "ai.appacadabra.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "pan",
      "intentFilters": [
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": {
            "mimeType": "*/*"
          }
        }
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_CALENDAR",
        "android.permission.READ_CONTACTS",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE",
        "android.permission.WRITE_CALENDAR",
        "android.permission.WRITE_CONTACTS",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-calendar",
        {
          "calendarPermission": "O app precisa acessar o calendário para ver e criar eventos."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O app precisa acessar suas fotos para definir ícones dos apps."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "O app precisa acessar o microfone para entrada de voz."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O app precisa acessar sua localização para apps que usam GPS."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 26
          }
        }
      ],
      [
        "react-native-health",
        {
          "NSHealthShareUsageDescription": "O app precisa aceder aos dados de saúde para apps gerados que monitorizam atividade.",
          "NSHealthUpdateUsageDescription": "O app pode atualizar dados de saúde para apps gerados."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2256826632523784~6570613208",
          "iosAppId": "ca-app-pub-2256826632523784~6570613208"
        }
      ],
      "./plugins/withAppacadabraNative"
    ]
  }
}
