# Normalize line endings: LF everywhere (repo + working tree, WSL-first workflow).
# Windows-only scripts keep CRLF so cmd.exe runs them reliably.
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.icns binary
*.jar binary
*.keystore binary
*.jks binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.mp4 binary
*.wav binary
*.ogg binary
*.pdf binary
*.zip binary
*.apk binary
*.aab binary
*.so binary
*.dylib binary
*.framework binary